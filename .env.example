# Токен бота от @BotFather
BOT_TOKEN=123456:ABC-DEF...

# Telegram ID единственного пользователя, которому бот отвечает.
# Узнать свой ID можно у @userinfobot
ADMIN_USER_ID=123456789

# Публичный адрес сервера для клиентских конфигов: IP или домен.
# Домен предпочтительнее — при смене IP клиенты продолжат работать.
# Оставьте пустым, чтобы бот определял IP автоматически.
VPN_HOST=

# Прокси для исходящих запросов к Telegram (оставьте пустым для прямого доступа).
# Поддерживаются SOCKS5 и HTTP прокси. MTProto-прокси НЕ подходят.
# Примеры:
# PROXY_URL=socks5://127.0.0.1:1080
# PROXY_URL=http://user:pass@proxy.example.com:8080
PROXY_URL=
